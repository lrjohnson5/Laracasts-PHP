{
    "name": "php-mvc-boilerplate/project",
    "description": "A simple PHP MVC boilerplate project",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-mutate": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "Core/",
            "Http\\": "Http/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
